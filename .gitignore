# --- Secrets ---
# Real Azure config lives in .env; .env.example is the template and stays tracked.
.env
*.env
!.env.example

# --- Sample / downloaded video files ---
# Videos here are large local binaries (people_jumping.mp4 alone is ~75MB) --
# re-supply or re-download them locally instead of committing them.
/input/
*.mp4
*.mov
*.avi
*.mkv

# --- Generated output (reports, annotated videos, downloaded sources) ---
# main.py/detect_all_actions.py/annotate_video.py all recreate this
# directory on demand (out_dir.mkdir(parents=True, exist_ok=True)).
/output/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.mypy_cache/
.coverage
htmlcov/

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Test / lint caches ---
.pytest_cache/
.ruff_cache/
.tox/

# --- Editor / OS cruft ---
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.bak
*.tmp
