# Copy this file to .env and fill in the values from your Azure AI Video
# Indexer account (see README.md "Azure setup" for how to create one).

# Standard Azure identifiers for the ARM resource.
AVI_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AVI_RESOURCE_GROUP=my-resource-group
AVI_ACCOUNT_NAME=my-video-indexer-account

# The Video Indexer "Account ID" (a GUID, different from the ARM account
# name) shown on the account's Overview page in the Azure portal.
AVI_ACCOUNT_ID=00000000-0000-0000-0000-000000000000

# The Azure region the Video Indexer account was created in, e.g. eastus.
AVI_LOCATION=eastus

# Optional tuning (defaults shown).
AVI_POLL_INTERVAL_SECONDS=10
AVI_PROCESSING_TIMEOUT_SECONDS=1800

# Authentication itself is handled by azure-identity's DefaultAzureCredential,
# which does NOT read the variables above. It will use, in order: an active
# `az login` session, or (for unattended/service-principal use) these:
# AZURE_TENANT_ID=...
# AZURE_CLIENT_ID=...
# AZURE_CLIENT_SECRET=...
